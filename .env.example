# Postgres connection string. In Coolify prod, use the internal service hostname.
DATABASE_URL=postgres://scout5090:password@localhost:5432/scout5090

# The Blue Alliance API v3 — get a free read key at https://www.thebluealliance.com/account
TBA_API_KEY=

# Statbotics API base — public, no auth needed. Override only if self-hosting a mirror.
STATBOTICS_API_BASE=https://api.statbotics.io/v3

# Our own team, used to default event/team pickers.
TEAM_NUMBER=5090

# Optional — powers the "analyze recorded video" AI draft feature on the scouting form.
# Get one at https://console.anthropic.com. Leave blank to skip that feature entirely;
# everything else in the app works without it.
ANTHROPIC_API_KEY=

# Random 32+ byte secret used to sign the session cookie. Generate with:
#   bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

PORT=3000
NODE_ENV=development

# Cookie domain in prod, e.g. .michel.filipkin.com — leave unset in dev
COOKIE_DOMAIN=

# "coolify" (default, relies on Coolify Scheduled Tasks) or "in-process" (dev-only timer fallback)
JOBS_MODE=in-process

LOG_LEVEL=debug
